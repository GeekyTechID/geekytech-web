# GeekyTech — salin ke .env.local dan isi nilai asli
# cp env.example .env.local   (Unix) / copy env.example .env.local   (Windows)

# ============================================================
# SUPABASE
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================================
# MIDTRANS
# ============================================================
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_IS_PRODUCTION=false

# ============================================================
# BITESHIP
# ============================================================
BITESHIP_API_KEY=biteship_test.xxxx
BITESHIP_IS_PRODUCTION=false
# Kode pos asal pengiriman (toko/gudang) untuk API tarif Biteship
BITESHIP_ORIGIN_POSTAL_CODE=10110

# ============================================================
# RESEND
# ============================================================
RESEND_API_KEY=re_xxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=GeekyTech
RESEND_ADMIN_EMAIL=admin@yourdomain.com

# ============================================================
# GOOGLE ANALYTICS
# ============================================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================================
# CLOUDFLARE TURNSTILE
# ============================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_site_key_here
TURNSTILE_SECRET_KEY=your_secret_key_here

# ============================================================
# APP
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# ============================================================
# WHATSAPP CS
# ============================================================
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
